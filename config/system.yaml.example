# Homalos量化交易系统配置文件 v0.0.1
# MVP架构配置 - 模块化单体部署

system:
  name: "Homalos Trading System"
  version: "0.0.1"
  log_level: "DEBUG"
  data_path: "data/"
  timezone: "Asia/Shanghai"
  # 测试模式配置
  test_mode: false  # 是否启用测试模式
  test_trading_hours: true  # 测试模式下是否绕过交易时间检查

# 事件总线配置
event_bus:
  name: "trading_system"
  max_async_queue_size: 10000
  max_sync_queue_size: 1000
  timer_interval: 1.0
  enable_monitoring: true
  enable_priority: true

# 数据库配置（SQLite简化部署）
database:
  type: "sqlite"
  path: "data/trading.db" 
  batch_size: 100
  flush_interval: 5
  connection_pool_size: 10
  enable_wal: true  # 启用WAL模式提高并发性能
  timezone: "UTC"

# 交易网关配置
gateway:
  # CTP配置
  ctp:
    enabled: true
    broker_id: "9999"
    md_address: "tcp://182.254.243.31:30011"
    td_address: "tcp://182.254.243.31:30001"
    app_id: "simnow_client_test"
    auth_code: "0000000000000000"
    user_id: "160219"  # 在实际使用时填写
    password: "donny@103010"  # 在实际使用时填写
    product_info: ""
    md_timeout: 30
    td_timeout: 30
    reconnect_interval: 5
    max_reconnect_attempts: 10
  
  # TTS配置（备用）
  tts:
    enabled: false
    broker_id: "9999"
    md_address: "tcp://180.166.37.178:41215"
    td_address: "tcp://121.37.90.193:20002"
    app_id: "tts_client_test"
    auth_code: "0000000000000000"
    user_id: "12396"  # 在实际使用时填写
    password: "123456"  # 在实际使用时填写
    product_info: ""
    md_timeout: 30
    td_timeout: 30
    reconnect_interval: 5
    max_reconnect_attempts: 10
  tts7x24:
    enabled: false
    broker_id: "9999"
    md_address: "tcp://121.37.80.177:20004"
    td_address: "tcp://121.37.80.177:20002"
    app_id: "tts_client_test"
    auth_code: "0000000000000000"
    user_id: "12396"  # 在实际使用时填写
    password: "123456"  # 在实际使用时填写
    product_info: ""
    md_timeout: 30
    td_timeout: 30
    reconnect_interval: 5
    max_reconnect_attempts: 10

# 风控配置 - 测试环境优化
risk:
  enabled: true
  max_position_size: 1000000     # 最大持仓金额（元）
  max_daily_loss: 50000          # 单日最大亏损（元）
  max_order_size: 100            # 单笔最大手数
  order_frequency_limit: 100     # 每秒最大订单数 (从10增加到100)
  position_concentration: 0.5    # 单品种最大仓位比例 (从0.3放宽到0.5)
  enable_self_trade_check: false # 启用自成交检查 (测试环境关闭)
  enable_price_check: true       # 启用价格合理性检查
  price_deviation_threshold: 0.1 # 价格偏离阈值 (从5%放宽到10%)

# 策略管理配置
strategy:
  base_path: "src/strategies/"
  auto_start: false
  max_concurrent_strategies: 10
  enable_hot_reload: true
  default_params:
    initial_capital: 100000
    max_drawdown: 0.1

# 策略增强管理配置
strategy_management:
  # 依赖检查配置
  dependency_check:
    enabled: true
    cache_ttl: 300  # 缓存时间（秒）
    timeout: 30     # 检查超时时间（秒）
    retry_attempts: 3
    checks:
      gateway_connection: true
      contract_info: true
      account_balance: true
      market_hours: true
      risk_limits: true
      data_feed: true
  
  # 策略验证配置
  strategy_validation:
    enabled: true
    cache_ttl: 600  # 缓存时间（秒）
    timeout: 60     # 验证超时时间（秒）
    validations:
      syntax_check: true
      required_methods: true
      parameter_validation: true
      risk_rules: true
      compatibility_check: true
    # 代码复杂度限制
    complexity_limits:
      max_cyclomatic_complexity: 10
      max_method_lines: 100
      max_class_methods: 20
  
  # 健康监控配置
  health_monitoring:
    enabled: true
    check_interval: 30      # 健康检查间隔（秒）
    metrics_window: 300     # 指标统计窗口（秒）
    auto_recovery: true     # 启用自动恢复
    max_recovery_attempts: 3
    
    # 健康阈值
    thresholds:
      max_error_rate: 0.05        # 最大错误率（5%）
      max_latency_ms: 1000        # 最大延迟（毫秒）
      min_success_rate: 0.95      # 最小成功率（95%）
      max_memory_usage_mb: 500    # 最大内存使用（MB）
      max_cpu_usage_percent: 80   # 最大CPU使用率（%）
    
    # 异常检测配置
    anomaly_detection:
      enabled: true
      sensitivity: 0.8  # 敏感度（0-1）
      min_samples: 10   # 最小样本数
  
  # 事件处理配置
  event_handling:
    enabled: true
    persistence: true
    database_path: "data/strategy_events.db"
    
    # 事件过滤配置
    filters:
      min_priority: "INFO"  # 最小事件优先级
      max_age_hours: 168    # 事件最大保存时间（小时，7天）
    
    # 事件聚合配置
    aggregation:
      enabled: true
      window_size: 60       # 聚合窗口（秒）
      max_events: 1000      # 最大事件数
    
    # 定时任务配置
    scheduled_tasks:
      flush_interval: 30    # 刷新到数据库间隔（秒）
      cleanup_interval: 3600 # 清理旧事件间隔（秒）
    
# 数据服务配置
data:
  # 行情数据
  market:
    buffer_size: 1000
    enable_persistence: true
    tick_storage_days: 30
    bar_storage_days: 365
    
  # 历史数据
  history:
    provider: "local"  # local, tushare, akshare
    cache_size: 1000
    
# Web管理界面配置
web:
  enabled: true
  host: "127.0.0.1"
  port: 8000
  debug: false
  cors_origins: ["*"]
  cors_methods: ["GET", "POST", "PUT", "DELETE"]
  cors_headers: ["*"]
  static_files: "web/static"
  templates: "web/templates"
  
  # WebSocket配置
  websocket:
    heartbeat_interval: 30
    max_connections: 100
    
  # API配置
  api:
    rate_limit: 100  # 每分钟最大请求数
    enable_swagger: true
    api_prefix: "/api/v1"

# 性能监控配置 - 测试环境优化
monitoring:
  enabled: true
  metrics_interval: 10  # 统计间隔（秒）
  enable_alerts: true
  
  # 性能阈值 - 测试环境适配
  thresholds:
    order_latency_ms: 100       # 调整为100ms适应测试环境
    tick_processing_rate: 1000
    memory_usage_mb: 32000      # 调整为32GB适应开发环境
    cpu_usage_percent: 95       # 调整为95%
    
  # 告警配置 - 测试环境适配
  alerts:
    high_latency_threshold: 200 # 调整为200ms
    memory_threshold: 32000     # 调整为32GB
    error_rate_threshold: 0.1   # 调整为10%

# 交易时段配置
trading_hours:
  enable_check: true
  sessions:
    # 期货交易时段
    futures:
      - ["09:00", "10:15"]   # 早盘
      - ["10:30", "11:30"]   # 早盘
      - ["13:30", "15:00"]   # 午盘
      - ["21:00", "02:30"]   # 夜盘(某些品种)
      - ["21:00", "23:00"]   # 夜盘(大部分品种)

# 邮件通知配置（可选）
email:
  enabled: false
  smtp_server: "smtp.qq.com"
  smtp_port: 465
  username: ""
  password: ""
  sender: ""
  receivers: []
  
  # 邮件触发条件
  triggers:
    system_error: true
    high_loss: true
    strategy_stopped: false

# 外部数据源配置（可选）
external_data:
  tushare:
    enabled: false
    token: ""
    
  akshare:
    enabled: false
    
  wind:
    enabled: false